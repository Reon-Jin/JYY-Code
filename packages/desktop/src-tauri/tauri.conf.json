{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JYYCode",
  "version": "1.0.0",
  "identifier": "ai.jyycode.desktop",
  "build": {
    "beforeDevCommand": "bun run --bun --cwd ../app dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "bun run --bun --cwd ../app build",
    "frontendDist": "../../app/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "JYYCode",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "transparent": true,
        "backgroundColor": "#181818",
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:*; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/jyycode-sidecar"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgxQ0E2NDBENzkyRURERUYKUldUdjNTNTVEV1RLZ2YwdGpkTWY0cGdNVFFteXJJeHk3cUJab2o3NzFzWE4rYnJmZ2NwQ1Y5a1QK",
      "endpoints": ["https://github.com/Reon-Jin/JYY-Code/releases/download/desktop-latest/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
