{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plan.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "goal", "status", "revision", "current_step", "steps", "created_at", "updated_at"],
  "properties": {
    "title": { "type": "string", "minLength": 1, "maxLength": 60 },
    "goal": { "type": "string", "minLength": 1 },
    "status": { "enum": ["draft", "active", "done"] },
    "revision": { "type": "integer", "minimum": 1 },
    "current_step": { "type": ["string", "null"] },
    "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "goal", "done_criteria", "status", "tasks"],
      "properties": {
        "id": { "type": "string", "pattern": "^s[1-9]\\d*$" },
        "title": { "type": "string", "minLength": 1 },
        "goal": { "type": "string", "minLength": 1 },
        "done_criteria": { "type": "string", "minLength": 1 },
        "status": { "enum": ["pending", "active", "done"] },
        "tasks": { "type": "array", "items": { "$ref": "#/$defs/task" } },
        "candidate_discussion": { "$ref": "#/$defs/candidateDiscussion" },
        "candidate_selection": { "$ref": "#/$defs/candidateSelection" }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "goal", "done_criteria", "output_path", "status", "dispatch", "report"],
      "properties": {
        "id": { "type": "string", "pattern": "^s[1-9]\\d*_t[1-9]\\d*$" },
        "title": { "type": "string", "minLength": 1 },
        "goal": { "type": "string", "minLength": 1 },
        "done_criteria": { "type": "string", "minLength": 1 },
        "instructions": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["standard", "candidate"] },
        "output_path": { "type": ["string", "null"] },
        "status": { "enum": ["pending", "dispatched", "running", "reported", "approved", "rejected", "dismissed"] },
        "dispatch": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/dispatch" }] },
        "report": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/report" }] },
        "merge": { "$ref": "#/$defs/merge" },
        "reopen_reason": { "type": "string", "minLength": 1 }
      }
    },
    "dispatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "child_session_id", "dispatched_at", "cancelled_at"],
      "properties": {
        "run_id": { "type": "string", "pattern": "^run__[A-Za-z0-9_-]+__s[1-9]\\d*_t[1-9]\\d*$" },
        "child_session_id": { "type": "string", "minLength": 1 },
        "dispatched_at": { "type": "string", "format": "date-time" },
        "cancelled_at": { "type": ["string", "null"], "format": "date-time" },
        "role": { "$ref": "#/$defs/profileSnapshot" },
        "launch": { "$ref": "#/$defs/launchSnapshot" },
        "workspace": { "$ref": "#/$defs/workspace" },
        "lifecycle": { "enum": ["reserved", "child_created", "starting", "running", "settled"] }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "root", "directory", "created_at", "cleanup"],
      "properties": {
        "mode": { "enum": ["worktree", "snapshot", "shared_compat"] },
        "root": { "type": "string", "minLength": 1 },
        "directory": { "type": ["string", "null"] },
        "created_at": { "type": ["string", "null"], "format": "date-time" },
        "cleanup": { "enum": ["on_success", "on_cancel", "retain_on_failure"] },
        "baseline_directory": { "type": ["string", "null"] },
        "baseline_manifest_hash": { "type": ["string", "null"] },
        "source_revision": { "type": ["string", "null"] }
      }
    },
    "profileSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "avatar"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "avatar": { "enum": ["bot", "search", "code", "bug", "chart", "file", "image", "folder", "pen", "sparkles"] }
      }
    },
    "launchSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "avatar", "prompt"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "avatar": { "enum": ["bot", "search", "code", "bug", "chart", "file", "image", "folder", "pen", "sparkles"] },
        "prompt": { "type": "string" },
        "model": { "type": "string" },
        "variant": { "type": "string" },
        "tools": { "type": "array", "items": { "type": "string" } }
      }
    },
    "candidateDiscussion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "ready_task_ids"],
      "properties": {
        "phase": { "enum": ["declaring", "cross_review", "awaiting_main", "running"] },
        "ready_task_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "candidateSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selected_task_id", "contributing_task_ids", "synthesis_artifact", "rationale", "selected_at"],
      "properties": {
        "selected_task_id": { "type": "string", "minLength": 1 },
        "contributing_task_ids": { "type": "array", "items": { "type": "string" } },
        "synthesis_artifact": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 },
        "selected_at": { "type": "string", "format": "date-time" }
      }
    },
    "merge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "attempt", "applied_paths", "conflicts", "started_at", "completed_at", "target_fingerprint", "cleanup"],
      "properties": {
        "status": { "enum": ["not_started", "pending", "running", "merged", "conflict", "failed"] },
        "attempt": { "type": "integer", "minimum": 0 },
        "applied_paths": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "conflicts": { "type": "array", "items": { "$ref": "#/$defs/mergeConflict" } },
        "started_at": { "type": ["string", "null"], "format": "date-time" },
        "completed_at": { "type": ["string", "null"], "format": "date-time" },
        "target_fingerprint": { "type": ["string", "null"] },
        "cleanup": { "enum": ["not_started", "pending", "completed", "failed"] },
        "journal_directory": { "type": ["string", "null"] },
        "error": { "type": "string", "minLength": 1 },
        "cleanup_error": { "type": "string", "minLength": 1 }
      }
    },
    "mergeConflict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["content", "add_add", "delete_modify", "binary", "symlink"] },
        "main_path": { "type": "string", "minLength": 1 },
        "child_path": { "type": "string", "minLength": 1 },
        "base_path": { "type": "string", "minLength": 1 },
        "fingerprint": { "type": "string", "minLength": 1 }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "summary", "artifacts", "issues", "reported_at", "review_feedback"],
      "properties": {
        "status": { "enum": ["done", "partial", "failed"] },
        "summary": { "type": "string", "minLength": 1 },
        "artifacts": { "type": "array", "items": { "type": "string" } },
        "issues": { "type": "array", "items": { "type": "string" } },
        "reported_at": { "type": "string", "format": "date-time" },
        "review_feedback": { "type": ["string", "null"] }
      }
    }
  }
}
