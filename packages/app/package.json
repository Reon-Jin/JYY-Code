{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@jyycode-ai/app",
  "version": "0.1.0",
  "description": "JYYCode Desktop Application (Electron + SolidJS)",
  "private": true,
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "vite",
    "build:electron-ts": "tsc -p tsconfig.electron.json && echo {\"type\":\"commonjs\"} > dist/main/package.json",
    "build": "bun run build:electron-ts && vite build",
    "build:electron": "bun run build && electron-builder",
    "preview": "vite preview"
  },
  "dependencies": {
    "@jyycode-ai/sdk": "workspace:*",
    "@solidjs/router": "^0.15.0",
    "solid-js": "catalog:"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.0.0",
    "typescript": "catalog:",
    "vite": "^6.0.0",
    "vite-plugin-solid": "^2.11.0",
    "@types/node": "catalog:"
  }
}
