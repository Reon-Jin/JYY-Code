      "@pierre/diffs": "1.1.0-beta.18",
      "opentui-spinner": "0.0.6",
      "diff": "8.0.2",
      "dompurify": "3.4.11",
      "drizzle-kit": "1.0.0-rc.2",
      "drizzle-orm": "1.0.0-rc.2",
      "effect": "4.0.0-beta.66",
      "ai": "6.0.168",
      "cross-spawn": "7.0.6",
      "fuzzysort": "3.1.0",
      "luxon": "3.6.1",
      "jsdom": "29.1.1",
      "katex": "0.17.0",
      "lucide-solid": "1.23.0",
      "marked": "17.0.1",
      "marked-katex-extension": "5.1.10",
      "remend": "1.3.0",
      "semver": "7.7.4",
      "typescript": "5.8.2",
