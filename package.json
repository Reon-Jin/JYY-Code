    "@types/mime-types": "3.0.1",
    "@typescript/native-preview": "catalog:",
    "glob": "13.0.5",
    "husky": "9.1.7",
    "oxlint": "1.60.0",
    "oxlint-tsgolint": "0.21.0",
    "prettier": "3.6.2",
    "semver": "^7.6.0",
    "turbo": "2.8.13"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Reon-Jin/JYY-Code"
  },
  "license": "MIT",
  "prettier": {
    "semi": false,
    "printWidth": 120
