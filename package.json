{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "jyycode-ai",
  "version": "1.15.10",
  "description": "JYYCode CLI installer",
  "private": false,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "bun run --cwd packages/jyycode --conditions=browser src/index.ts",
    "lint": "oxlint",
    "typecheck": "bun turbo typecheck",
    "postinstall": "node ./script/postinstall.cjs",
    "prepare": "node ./script/prepare.cjs",
    "test": "echo 'do not run tests from root' && exit 1"
  },
  "bin": {
    "jyy": "./bin/jyycode.cjs",
    "jyycode": "./bin/jyycode.cjs"
  },
  "files": [
    "bin",
    "script/postinstall.cjs",
    "script/prepare.cjs",
    "LICENSE",
    "README.md",
    "README-zh.md"
  ],
  "workspaces": {
    "packages": [
      "packages/*",
      "packages/sdk/js"
    ],
    "catalog": {
      "@fontsource-variable/inter": "5.2.8",
      "@fontsource-variable/jetbrains-mono": "5.2.8",
      "@effect/opentelemetry": "4.0.0-beta.66",
      "@effect/platform-node": "4.0.0-beta.66",
      "@effect/sql-sqlite-bun": "4.0.0-beta.66",
      "@npmcli/arborist": "9.4.0",
      "@solidjs/router": "0.16.1",
      "@solidjs/testing-library": "0.8.10",
      "@tanstack/solid-query": "5.101.2",
      "@tauri-apps/api": "2.11.1",
      "@tauri-apps/cli": "2.11.4",
      "@tauri-apps/plugin-dialog": "2.7.1",
      "@tauri-apps/plugin-notification": "2.3.3",
      "@tauri-apps/plugin-store": "2.4.3",
      "@tauri-apps/plugin-updater": "2.10.1",
      "@testing-library/jest-dom": "6.9.1",
      "@testing-library/user-event": "14.6.1",
      "@types/bun": "1.3.13",
      "@types/cross-spawn": "6.0.6",
      "@octokit/rest": "22.0.0",
      "@opentui/core": "0.2.15",
      "@opentui/keymap": "0.2.15",
      "@opentui/solid": "0.2.15",
      "ulid": "3.0.1",
      "@types/node": "24.12.2",
      "@types/semver": "7.7.1",
